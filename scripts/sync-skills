#!/usr/bin/env python3
"""sync-skills — copy hugr/skills-src/* into ecosystem repos.

Usage:
  sync-skills [--dry-run] [--help]
  sync-skills --target <repo-dir> [--dry-run]
  sync-skills --all [--dry-run]

By default (no --target / --all) copies into hugr's own
.claude/skills/ only.

Generated files get a "do not edit" header prepended to SKILL.md,
and the frontmatter metadata.suite_version field is stamped with the
current git SHA of skills-src.

Validation rules (applied before any copy):
  - SKILL.md frontmatter must have: name, description, metadata.suite_version
  - name must be lowercase, max 64 chars
  - name must match the directory name (hugr-suite-<component>)
"""

from __future__ import annotations

import argparse
import os
import re
import shutil
import subprocess
import sys
from pathlib import Path

# ---------------------------------------------------------------------------
# Paths
# ---------------------------------------------------------------------------

SCRIPT_DIR = Path(__file__).resolve().parent
REPO_ROOT   = SCRIPT_DIR.parent
SKILLS_SRC  = REPO_ROOT / "skills-src"

# Sibling repos relative to REPO_ROOT (i.e. ~/code/<name>)
ECOSYSTEM_REPOS: dict[str, Path] = {
    "hugr":            REPO_ROOT,
    "yaams":           REPO_ROOT.parent / "yaams",
    "cognitive-ledger": REPO_ROOT.parent / "cognitive-ledger",
    "owa-piggy":       REPO_ROOT.parent / "owa-piggy",
    "owa-tools":       REPO_ROOT.parent / "owa-tools",
}

# ---------------------------------------------------------------------------
# Header injected at the top of every generated SKILL.md
# ---------------------------------------------------------------------------

_GENERATED_HEADER = """\
<!-- generated by hugr/scripts/sync-skills — do not edit directly.
     edit the source at hugr/skills-src/{skill_dir}/SKILL.md and re-run sync-skills. -->
"""

# ---------------------------------------------------------------------------
# Frontmatter validation
# ---------------------------------------------------------------------------

_NAME_RE     = re.compile(r"^name:\s*(.+)$", re.MULTILINE)
_DESC_RE     = re.compile(r"^description:\s*(.+)$", re.MULTILINE)
_VERSION_RE  = re.compile(r'suite_version:\s*"([^"]+)"', re.MULTILINE)


def _parse_frontmatter(text: str) -> dict[str, str]:
    """Extract name, description, suite_version from YAML frontmatter."""
    result: dict[str, str] = {}
    m = _NAME_RE.search(text)
    if m:
        result["name"] = m.group(1).strip()
    m = _DESC_RE.search(text)
    if m:
        result["description"] = m.group(1).strip()
    m = _VERSION_RE.search(text)
    if m:
        result["suite_version"] = m.group(1).strip()
    return result


def validate_skill_md(skill_dir: Path) -> list[str]:
    """Return a list of validation errors (empty = ok)."""
    errors: list[str] = []
    skill_md = skill_dir / "SKILL.md"
    if not skill_md.exists():
        errors.append(f"{skill_md}: file not found")
        return errors

    text = skill_md.read_text(encoding="utf-8")
    fm = _parse_frontmatter(text)

    name = fm.get("name", "")
    if not name:
        errors.append(f"{skill_md}: 'name' field missing from frontmatter")
    else:
        if name != name.lower():
            errors.append(f"{skill_md}: name '{name}' must be lowercase")
        if len(name) > 64:
            errors.append(f"{skill_md}: name '{name}' exceeds 64-char limit ({len(name)} chars)")
        expected_name = skill_dir.name
        if name != expected_name:
            errors.append(
                f"{skill_md}: name '{name}' does not match directory name '{expected_name}'"
            )

    if not fm.get("description"):
        errors.append(f"{skill_md}: 'description' field missing from frontmatter")

    if not fm.get("suite_version"):
        errors.append(f"{skill_md}: metadata.suite_version missing from frontmatter")

    return errors


# ---------------------------------------------------------------------------
# Git SHA stamping
# ---------------------------------------------------------------------------

def _skills_src_sha() -> str:
    """Return the current HEAD SHA (short) for suite_version stamping."""
    try:
        result = subprocess.run(
            ["git", "rev-parse", "--short", "HEAD"],
            cwd=str(REPO_ROOT),
            capture_output=True,
            text=True,
            check=True,
        )
        return result.stdout.strip()
    except Exception:
        return "unknown"


def _stamp_version(text: str, sha: str) -> str:
    """Replace metadata.suite_version value with sha."""
    return re.sub(
        r'(suite_version:\s*)"[^"]*"',
        rf'\1"{sha}"',
        text,
    )


# ---------------------------------------------------------------------------
# Copy logic
# ---------------------------------------------------------------------------

def _copy_skill(
    skill_dir: Path,
    dest_skills_root: Path,
    sha: str,
    dry_run: bool,
    verbose: bool,
) -> bool:
    """Copy one skill directory into dest_skills_root/<skill_name>/. Return True on success."""
    skill_name = skill_dir.name
    dest = dest_skills_root / skill_name

    if dry_run:
        print(f"  [dry-run] would copy {skill_dir} -> {dest}")
        return True

    if dest.exists():
        shutil.rmtree(dest)
    shutil.copytree(skill_dir, dest)

    # Stamp suite_version + prepend generated header to SKILL.md
    skill_md = dest / "SKILL.md"
    if skill_md.exists():
        text = skill_md.read_text(encoding="utf-8")
        text = _stamp_version(text, sha)
        header = _GENERATED_HEADER.format(skill_dir=skill_name)
        skill_md.write_text(header + text, encoding="utf-8")

    if verbose:
        print(f"  copied  {skill_name} -> {dest}")
    return True


def sync_to_repo(repo_path: Path, sha: str, dry_run: bool, verbose: bool) -> int:
    """Sync all skills-src/* into repo_path/.claude/skills/. Return error count."""
    if not repo_path.is_dir():
        print(f"  warning: repo {repo_path} not found; skipping", file=sys.stderr)
        return 0

    dest_root = repo_path / ".claude" / "skills"

    if dry_run:
        print(f"  [dry-run] target: {dest_root}")
    else:
        dest_root.mkdir(parents=True, exist_ok=True)

    errors = 0
    for skill_dir in sorted(SKILLS_SRC.iterdir()):
        if not skill_dir.is_dir():
            continue
        errs = validate_skill_md(skill_dir)
        if errs:
            for e in errs:
                print(f"  validation error: {e}", file=sys.stderr)
            errors += len(errs)
            continue
        _copy_skill(skill_dir, dest_root, sha, dry_run, verbose)

    return errors


# ---------------------------------------------------------------------------
# CLI
# ---------------------------------------------------------------------------

def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(
        description=__doc__,
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    parser.add_argument(
        "--dry-run",
        action="store_true",
        help="Print what would be done without touching the filesystem.",
    )
    parser.add_argument(
        "--all",
        action="store_true",
        help="Sync into all known ecosystem repos (hugr, yaams, cognitive-ledger, owa-piggy, owa-tools).",
    )
    parser.add_argument(
        "--target",
        metavar="REPO_DIR",
        help="Sync into a specific repo directory instead of the defaults.",
    )
    parser.add_argument(
        "--validate-only",
        action="store_true",
        help="Validate SKILL.md files without copying.",
    )
    parser.add_argument(
        "--quiet",
        action="store_true",
        help="Suppress per-file output (errors still shown).",
    )
    args = parser.parse_args(argv)

    verbose = not args.quiet

    if not SKILLS_SRC.is_dir():
        print(f"error: skills-src directory not found at {SKILLS_SRC}", file=sys.stderr)
        return 1

    # --validate-only mode
    if args.validate_only:
        total_errors = 0
        for skill_dir in sorted(SKILLS_SRC.iterdir()):
            if not skill_dir.is_dir():
                continue
            errs = validate_skill_md(skill_dir)
            if errs:
                for e in errs:
                    print(f"FAIL: {e}", file=sys.stderr)
                total_errors += len(errs)
            elif verbose:
                print(f"ok:   {skill_dir.name}")
        if total_errors:
            print(f"\n{total_errors} validation error(s)", file=sys.stderr)
            return 1
        if verbose:
            print("all SKILL.md files pass validation")
        return 0

    sha = _skills_src_sha()
    if verbose:
        print(f"suite_version: {sha}")

    # Determine target repos
    if args.target:
        targets: dict[str, Path] = {"custom": Path(args.target)}
    elif args.all:
        targets = ECOSYSTEM_REPOS
    else:
        targets = {"hugr": REPO_ROOT}

    total_errors = 0
    for repo_name, repo_path in targets.items():
        if verbose or args.dry_run:
            print(f"\n-> {repo_name} ({repo_path})")
        errs = sync_to_repo(repo_path, sha, dry_run=args.dry_run, verbose=verbose)
        total_errors += errs

    if total_errors:
        print(f"\n{total_errors} error(s) — no files written for affected skills", file=sys.stderr)
        return 1

    if verbose and not args.dry_run:
        print("\ndone.")
    return 0


if __name__ == "__main__":
    sys.exit(main())
